      { id: 5, title: 'Escultura Gabriela', category: 'personagem', src: 'imagens_trabalhos/escultura_Gabriela_r01.225.jpg' },
      { id: 6, title: 'Garrafa Crânio', category: 'objeto', src: 'imagens_trabalhos/garrafacranio_ks_01.247.jpg' },
      { id: 7, title: 'Chaveiro 3D', category: 'objeto', src: 'imagens_trabalhos/cena_chav01.268.jpg' },
      { id: 8, title: 'Vaso de Cristal', category: 'objeto', src: 'imagens_trabalhos/vazoimg01.243.jpg' },
      { id: 9, title: 'Bowl Velarisceira', category: 'objeto', src: 'imagens_trabalhos/cena_velariseira01.bip.242.jpg' },
      { id: 10, title: 'Emblema Hermès', category: 'emblema', src: 'imagens_trabalhos/img_hermes01.jpg' },
      { id: 11, title: 'Fênix Bolívia', category: 'emblema', src: 'imagens_trabalhos/img_fenix01.jpg' }
    ];

    let currentImageIndex = 0;
    let filteredProjects = [...projects];

    function renderGallery(items) {
      const grid = document.getElementById('galleryGrid');
      grid.innerHTML = '';

      if (items.length === 0) {
        grid.innerHTML = '<p style="color: #666; grid-column: 1/-1;">Nenhuma imagem encontrada.</p>';
        return;
      }

      items.forEach((item, index) => {
        const card = document.createElement('div');
        card.className = 'card';
        card.onclick = () => openLightbox(index);

        card.innerHTML = `
          <div class="card-img-wrapper">
            <img src="${item.src}" class="card-img" alt="${item.title}" loading="lazy">
          </div>
          <div class="card-info">
            <div class="card-category">${item.category}</div>
            <div class="card-title">${item.title}</div>
          </div>
        `;
        grid.appendChild(card);
      });
    }

    function filterGallery(category, evt) {
      document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
      if (evt && evt.currentTarget) evt.currentTarget.classList.add('active');

      if (category === 'todos') {
        filteredProjects = [...projects];
      } else {
        filteredProjects = projects.filter(p => p.category.toLowerCase() === category.toLowerCase());
      }
      renderGallery(filteredProjects);
    }

    function loadLocalImages(event) {
      const files = event.target.files;
      if (!files.length) return;

      projects = [];
      let count = 1;

      for (let file of files) {
        if (file.type.startsWith('image/')) {
          const fileUrl = URL.createObjectURL(file);
          const nameWithoutExt = file.name.substring(0, file.name.lastIndexOf('.')) || file.name;
          
          projects.push({
            id: count++,
            title: nameWithoutExt.replace(/[-_]/g, ' '),
            category: 'Geral',
            src: fileUrl
          });
        }
      }

      filteredProjects = [...projects];
      renderGallery(filteredProjects);
    }

    function openLightbox(index) {
      currentImageIndex = index;
      const item = filteredProjects[currentImageIndex];
      document.getElementById('lightboxImg').src = item.src;
      document.getElementById('lightboxTitle').innerText = item.title;
      document.getElementById('lightboxCat').innerText = item.category;
      document.getElementById('lightbox').classList.add('active');
    }

    function closeLightbox() {
      document.getElementById('lightbox').classList.remove('active');
    }

    function nextImage() {
      currentImageIndex = (currentImageIndex + 1) % filteredProjects.length;
      openLightbox(currentImageIndex);
    }

    function prevImage() {
      currentImageIndex = (currentImageIndex - 1 + filteredProjects.length) % filteredProjects.length;
      openLightbox(currentImageIndex);
    }

    renderGallery(projects);
  </script>
</body>
</html>

